# Configuração do backend.
# Copie este arquivo para ".env" dentro da pasta backend/ e ajuste se necessário.
# Nunca commitar o arquivo ".env" real (já está no .gitignore).

# Usada (banco de dados) pelo SQLAlchemy/Alembic.
# Precisa bater com as credenciais do .env da raiz usadas pelo docker-compose.
DATABASE_URL=postgresql+psycopg://kijapa:kijapa_dev_password@localhost:5432/kijapa_db

# Usada pelos testes automatizados (pytest). É um banco
# separado do banco de desenvolvimento — os testes recriam o schema do zero a
# cada execução, então nunca deve apontar para o mesmo banco do DATABASE_URL acima.
TEST_DATABASE_URL=postgresql+psycopg://kijapa:kijapa_dev_password@localhost:5432/kijapa_db_test

# Usada (configuração da API) para liberar o frontend a chamar o backend.
CORS_ORIGINS=http://localhost:5173

# com a API S3), usadas por photo_storage_service.py para subir as fotos de
# comprovação. Sem as cinco preenchidas, o upload de foto falha com
# PHOTO_UPLOAD_FAILED (ver photo_storage_service.PhotoStorageConfigError).
# R2_ACCOUNT_ID monta o endpoint da API S3
# URL PÚBLICA do bucket (domínio customizado, ou o subdomínio
# diferente do endpoint acima, que nunca é público.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Autenticação ---
# Chave de assinatura dos tokens JWT. Gere um valor novo por ambiente com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Nunca reaproveite este valor de exemplo em produção.
SECRET_KEY=troque-este-valor-por-um-gerado-com-secrets.token_urlsafe

# Em desenvolvimento local (http://localhost, sem HTTPS) precisa ser "false".
# Em produção (atrás de HTTPS) deve ser "true".
COOKIE_SECURE=false

# "strict" (padrão, mais seguro) funciona quando frontend e backend ficam no
# MESMO domínio-raiz (é o caso do desenvolvimento local, e de deploys onde as
# duas peças moram sob o mesmo domínio). Se o frontend e o backend forem
# hospedados em domínios DIFERENTES de verdade (ex.: frontend na Cloudflare
# Pages, backend no Render), troque para "none" — exige COOKIE_SECURE=true.
# Sem isso, o navegador nunca reenvia o cookie do refresh token em chamadas
# cross-site, e a sessão "cai sozinha" sem nenhum erro visível.
COOKIE_SAMESITE=strict

# Credenciais do usuário MASTER inicial, usadas só pelo script
# scripts/seed_master_user.py (rodar manualmente, uma vez). Use uma senha forte
# de verdade — mesmo em desenvolvimento local.
MASTER_USER_NAME=Administrador Master
MASTER_USER_EMAIL=master@kijapa.com
MASTER_USER_PASSWORD=defina-uma-senha-forte-aqui
