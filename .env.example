# Variáveis usadas pelo docker-compose.yml para criar o banco Postgres local.
# Copie este arquivo para ".env" (na raiz) e ajuste se quiser valores diferentes.
# O arquivo ".env" nunca deve ser commitado (já está no .gitignore).

POSTGRES_USER=kijapa
POSTGRES_PASSWORD=kijapa_dev_password
POSTGRES_DB=kijapa_db
POSTGRES_PORT=5432
